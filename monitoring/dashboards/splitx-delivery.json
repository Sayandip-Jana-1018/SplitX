{
  "uid": "splitx-delivery",
  "title": "SplitX · Delivery",
  "description": "From a merge on main to a running pod: what GitHub announced, what the relay carried, what Jenkins did about it.",
  "tags": [
    "splitx"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "type": "text",
      "title": "From a merge to a running pod",
      "options": {
        "mode": "markdown",
        "content": "A merge to `main` that passes CI becomes a release: GitHub Actions builds the image once, scans it, signs it with cosign and publishes it to ghcr.io, then announces it as a **GitHub deployment** (D-054).\n\nGitHub signs the webhook that carries the announcement. It reaches Jenkins through the relay in this cluster (D-056), which cannot forge or change it: Jenkins checks the signature itself.\n\nJenkins then verifies the image was signed by this repository's workflow on `main` for that exact commit, applies the release commit's own manifests, checks the rollout through the ingress, and rolls back anything that does not come up (D-055)."
      }
    },
    {
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "type": "row",
      "title": "Now",
      "collapsed": false,
      "panels": []
    },
    {
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 6
      },
      "type": "stat",
      "title": "Last deploy",
      "description": "The result of the most recent splitx-deploy build. A failed deploy has already been rolled back: Jenkins puts the previous revision back before it reports.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "default_jenkins_builds_last_build_result_ordinal{jenkins_job=\"splitx-deploy\"}",
          "legendFormat": "__auto",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Success",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "Unstable",
                  "color": "yellow",
                  "index": 1
                },
                "2": {
                  "text": "Failed, rolled back",
                  "color": "red",
                  "index": 2
                },
                "3": {
                  "text": "Not built",
                  "color": "text",
                  "index": 3
                },
                "4": {
                  "text": "Aborted",
                  "color": "orange",
                  "index": 4
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 5,
        "y": 6
      },
      "type": "stat",
      "title": "How long it took",
      "description": "Wall-clock time of the last deploy: verifying the signature, applying the manifests, waiting for the rollout and checking it through the ingress.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "default_jenkins_builds_last_build_duration_milliseconds{jenkins_job=\"splitx-deploy\"}",
          "legendFormat": "__auto",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "mappings": [],
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 10,
        "y": 6
      },
      "type": "stat",
      "title": "Webhook stream",
      "description": "Whether the relay is holding its smee.io channel open. While it is not, GitHub's deliveries are lost and have to be redelivered; an alert fires after five minutes.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(webhook_relay_connected{namespace=\"jenkins\"})",
          "legendFormat": "__auto",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Lost",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Connected",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 15,
        "y": 6
      },
      "type": "stat",
      "title": "Deliveries refused, this range",
      "description": "Deliveries Jenkins would not accept: 403 for a signature that did not verify, or no answer at all. Anything above zero is worth reading the relay log for.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(webhook_relay_deliveries_total{namespace=\"jenkins\", result!=\"accepted\"}[$__range])) or vector(0)",
          "legendFormat": "__auto",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [],
          "color": {
