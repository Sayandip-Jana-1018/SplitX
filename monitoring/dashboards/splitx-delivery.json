      "type": "timeseries",
      "title": "Webhook deliveries",
      "description": "What the relay carried, by what Jenkins answered. \"accepted\" means the signature verified — a ping is accepted too, and starts no build.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (result) (increase(webhook_relay_deliveries_total{namespace=\"jenkins\"}[$__rate_interval]))",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
