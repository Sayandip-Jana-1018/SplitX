{
  "uid": "splitx-logs",
  "title": "SplitX · Logs",
  "description": "Logs of the SplitX pods and of ingress-nginx, from Loki. Provisioned from monitoring/dashboards/splitx-logs.json.",
  "tags": [
    "splitx"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "request_id",
        "label": "request_id",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "description": "An X-Request-Id, 32 hexadecimal characters.",
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "title": "SplitX · Service",
      "type": "link",
      "url": "/d/splitx-service",
      "icon": "dashboard"
    }
  ],
  "panels": [
    {
      "id": 1,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "type": "text",
      "title": "Find a request",
      "options": {
        "mode": "markdown",
        "content": "Every response carries an `X-Request-Id` header, and SplitX shows it with any error. Paste one into **request_id** above: the panel below lists every line that request wrote, from the ingress access log and from the pod that served it. The request ID is stored as structured metadata, not a label, so any number of them costs nothing to index."
      }
    },
    {
      "id": 2,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "type": "logs",
      "title": "Everything one request wrote",
      "description": "The ingress access line and the application lines of the request whose ID is in the request_id box.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{namespace=~\"splitx|ingress-nginx\"} | request_id=\"$request_id\"",
          "legendFormat": "__auto",
          "queryType": "range",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 3,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "type": "timeseries",
      "title": "Application log lines by level",
      "description": "Lines per minute from the SplitX pods, by level. Errors are server errors and failed dependencies; warnings include refused and rate-limited requests.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (level) (count_over_time({namespace=\"splitx\", app=\"splitx\"} [1m]))",
          "legendFormat": "{{level}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "type": "timeseries",
      "title": "Edge responses by status",
      "description": "Requests per minute through ingress-nginx, by status code, from its JSON access log.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (status) (count_over_time({namespace=\"ingress-nginx\", container=\"controller\"} | json | __error__=\"\" [1m]))",
          "legendFormat": "{{status}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "type": "logs",
      "title": "Application warnings and errors",
      "description": "The newest first. Open a line for its request ID, pod and build.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{namespace=\"splitx\", app=\"splitx\", level=~\"error|warn\"}",
          "legendFormat": "__auto",
          "queryType": "range",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 6,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "type": "logs",
      "title": "Slow or failed at the edge",
      "description": "Access lines with a 5xx status or taking longer than a second at the ingress.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{namespace=\"ingress-nginx\", container=\"controller\"} | json | __error__=\"\" | status >= 500 or request_time > 1",
          "legendFormat": "__auto",
          "queryType": "range",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 7,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "type": "logs",
      "title": "All application logs",
      "description": "Every line from the SplitX pods, including the database and cache containers.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{namespace=\"splitx\"}",
          "legendFormat": "__auto",
          "queryType": "range",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    }
  ]
}
