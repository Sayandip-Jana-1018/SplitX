    {
      "id": 2,
      "type": "stat",
      "title": "Requests / s",
      "description": "Requests from people over the last minute. Health checks and Prometheus scrapes are left out.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(splitx_http_requests_total{namespace=\"splitx\", route!~\"/api/health/.*|/api/metrics\"}[1m])) or vector(0)",
          "legendFormat": "__auto",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Unintended errors",
      "description": "Server errors that were not deliberate load shedding, as a share of requests from people over 5 minutes. SplitXServerErrors fires above 2%.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "((sum(rate(splitx_http_requests_total{namespace=\"splitx\", route!~\"/api/health/.*|/api/metrics\", status_code=~\"5..\"}[5m])) or vector(0)) - (sum(rate(splitx_settlement_previews_total{namespace=\"splitx\", outcome=\"shed\"}[5m])) or vector(0))) / (sum(rate(splitx_http_requests_total{namespace=\"splitx\", route!~\"/api/health/.*|/api/metrics\"}[5m])) > 0) or vector(0)",
          "legendFormat": "__auto",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.02
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p95 response time",
      "description": "Requests from people over 5 minutes. SplitXSlowResponses fires above 1 s.",
