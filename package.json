{
  "name": "SplitX",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "test": "vitest run --project unit && node tests/production-hardening.test.mjs",
    "prepare": "husky",
    "verify:metrics": "node --env-file=.env scripts/verify-metrics.mjs",
    "scan:secrets": "gitleaks git . --config .gitleaks.toml --redact --no-banner",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@opentelemetry/api": "1.9.1",
