{
  "name": "SplitX",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/tesseract-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/tesseract-assets.mjs",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "test": "vitest run --project unit && node tests/production-hardening.test.mjs",
    "prepare": "husky",
    "verify:metrics": "node --env-file=.env scripts/verify-metrics.mjs",
    "scan:secrets": "gitleaks git . --config .gitleaks.toml --redact --no-banner",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "test:db": "vitest run --project database",
    "test:alerts": "node scripts/test-alerts.mjs",
    "ledger:audit": "node --env-file=.env scripts/ledger-audit.mjs",
    "email:test": "node --env-file=.env scripts/email-test.mjs",
    "image:build": "node scripts/image-build.mjs",
    "aws:bootstrap": "node --env-file=.env scripts/aws-bootstrap.mjs",
    "aws:secrets": "node --env-file=.env scripts/aws-secrets.mjs",
    "image:report": "node --env-file=.env scripts/image-report.mjs",
    "db:schema": "node scripts/db-schema.mjs",
    "avatars:check": "node --env-file=.env scripts/migrate-avatars.mjs",
    "avatars:migrate": "node --env-file=.env scripts/migrate-avatars.mjs --apply",
    "k8s:up": "node scripts/cluster-up.mjs",
    "k8s:pause": "node scripts/cluster-power.mjs pause",
    "k8s:resume": "node scripts/cluster-power.mjs resume",
    "k8s:verify": "node scripts/cluster-verify.mjs",
    "cd:verify": "node scripts/delivery-verify.mjs",
    "k8s:render": "kubectl kustomize k8s/overlays/aws",
    "k8s:down": "kind delete cluster --name splitx"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@prisma/client": "^6.19.2",
    "@supabase/supabase-js": "^2.97.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@upstash/redis": "^1.36.2",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.34.0",
    "ioredis": "6.0.0",
    "lucide-react": "^0.564.0",
    "next": "^16.3.5",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^10.0.10",
    "prom-client": "^15.1.3",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "^5.5.0",
    "recharts": "^3.7.0",
    "resend": "^6.9.2",
    "swr": "^2.4.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@playwright/test": "1.61.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.11",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "prisma": "^6.19.2",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    }
  }
}
