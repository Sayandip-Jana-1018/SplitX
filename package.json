{
  "name": "SplitIT",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/tesseract-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/tesseract-assets.mjs",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "lint:unused": "knip --no-progress",
    "test": "vitest run --project unit && node tests/production-hardening.test.mjs",
    "prepare": "husky",
    "scan:secrets": "gitleaks git . --config .gitleaks.toml --redact --no-banner",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "test:db": "vitest run --project database",
    "test:db:coverage": "vitest run --project database --coverage --coverage.reportsDirectory=coverage-database",
    "ledger:audit": "node --env-file=.env scripts/ledger-audit.mjs",
    "email:test": "node --env-file=.env scripts/email-test.mjs",
    "avatars:check": "node --env-file=.env scripts/migrate-avatars.mjs",
    "avatars:migrate": "node --env-file=.env scripts/migrate-avatars.mjs --apply"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.119.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@upstash/redis": "^1.41.0",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^13.4.4",
    "ioredis": "6.0.0",
    "jose": "^6.2.17",
    "lucide-react": "^1.74.0",
    "next": "^16.4.6",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^10.6.0",
    "qrcode.react": "^4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "^5.7.0",
    "recharts": "^3.10.1",
    "resend": "^6.38.1",
    "swr": "^2.5.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "1.65.1",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "knip": "^6.45.1",
    "prisma": "^6.19.3",
    "typescript": "^5",
    "vitest": "5.1.0"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    }
  }
}
