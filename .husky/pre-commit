# Block commits that introduce secrets. The scan covers staged changes only.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is required (winget install Gitleaks.Gitleaks | brew install gitleaks)" >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner --config .gitleaks.toml || exit 1

npx eslint --max-warnings 0 .
