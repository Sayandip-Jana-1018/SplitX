{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CoreInfrastructure",
      "Effect": "Allow",
      "Action": [
        "ec2:*", "eks:*", "elasticloadbalancing:*", "autoscaling:*",
        "application-autoscaling:*", "cloudfront:*", "logs:*", "cloudwatch:*",
        "kms:*", "budgets:*", "tag:*", "sts:GetCallerIdentity",
        "iam:Get*", "iam:List*", "servicequotas:GetServiceQuota"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SplitXStacks",
      "Effect": "Allow",
      "Action": "cloudformation:*",
      "Resource": [
        "arn:aws:cloudformation:*:918183256068:stack/splitx-*/*",
        "arn:aws:cloudformation:*:918183256068:changeSet/*/*"
      ]
    },
    {
      "Sid": "StackReads",
      "Effect": "Allow",
      "Action": [
        "cloudformation:ValidateTemplate", "cloudformation:ListStacks",
        "cloudformation:DescribeStacks", "cloudformation:GetTemplateSummary",
        "cloudformation:ListExports"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SplitXBucketsOnly",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": ["arn:aws:s3:::splitx-*", "arn:aws:s3:::splitx-*/*"]
    },
    {
      "Sid": "ListBuckets",
      "Effect": "Allow",
      "Action": ["s3:ListAllMyBuckets", "s3:GetBucketLocation"],
      "Resource": "*"
    },
    {
      "Sid": "SplitXTopics",
      "Effect": "Allow",
      "Action": "sns:*",
      "Resource": "arn:aws:sns:*:918183256068:splitx-*"
    },
    {
      "Sid": "SplitXSecrets",
      "Effect": "Allow",
      "Action": "secretsmanager:*",
      "Resource": "arn:aws:secretsmanager:*:918183256068:secret:splitx/*"
    },
    {
      "Sid": "ListTopicsAndSecrets",
      "Effect": "Allow",
      "Action": ["sns:ListTopics", "secretsmanager:ListSecrets"],
      "Resource": "*"
    },
    {
      "Sid": "NewRolesCarryTheBoundary",
      "Effect": "Allow",
      "Action": ["iam:CreateRole", "iam:PutRolePermissionsBoundary"],
      "Resource": "arn:aws:iam::918183256068:role/splitx-*",
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::918183256068:policy/splitx-ci-boundary"
        }
      }
    },
    {
      "Sid": "ManageSplitXRoles",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteRole", "iam:AttachRolePolicy", "iam:DetachRolePolicy",
        "iam:PutRolePolicy", "iam:DeleteRolePolicy", "iam:TagRole",
        "iam:UntagRole", "iam:UpdateAssumeRolePolicy", "iam:UpdateRole",
        "iam:UpdateRoleDescription"
      ],
      "Resource": "arn:aws:iam::918183256068:role/splitx-*"
    },
    {
      "Sid": "PassSplitXRolesToTheirServices",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::918183256068:role/splitx-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": ["eks.amazonaws.com", "ec2.amazonaws.com", "pods.eks.amazonaws.com"]
        }
      }
    },
    {
      "Sid": "SplitXPolicies",
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicy", "iam:DeletePolicy", "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion", "iam:SetDefaultPolicyVersion",
        "iam:TagPolicy", "iam:UntagPolicy"
      ],
      "Resource": "arn:aws:iam::918183256068:policy/splitx-*"
    },
    {
      "Sid": "OIDCProviders",
      "Effect": "Allow",
      "Action": [
        "iam:CreateOpenIDConnectProvider", "iam:DeleteOpenIDConnectProvider",
        "iam:TagOpenIDConnectProvider", "iam:UntagOpenIDConnectProvider",
        "iam:UpdateOpenIDConnectProviderThumbprint",
        "iam:AddClientIDToOpenIDConnectProvider",
        "iam:RemoveClientIDFromOpenIDConnectProvider"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ServiceLinkedRoles",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::918183256068:role/aws-service-role/*"
    },
    {
      "Sid": "NeverItsOwnPermissions",
      "Effect": "Deny",
      "Action": [
        "iam:CreatePolicyVersion", "iam:DeletePolicyVersion",
        "iam:SetDefaultPolicyVersion", "iam:DeletePolicy"
      ],
      "Resource": "arn:aws:iam::918183256068:policy/splitx-devops-policy"
    },
    {
      "Sid": "BoundariesStay",
      "Effect": "Deny",
      "Action": "iam:DeleteRolePermissionsBoundary",
      "Resource": "*"
    }
  ]
}
