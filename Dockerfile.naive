# ═══════════════════════════════════════════════════════════════
#   SplitX — NAIVE image. A comparison exhibit only: never deploy it.
#
#   This is how the app would be containerised without any care:
#   one stage, the full Debian Node image, every dev dependency and
#   the build toolchain shipped, no cache mounts, running as root.
#   scripts/image-report.mjs builds it next to the real Dockerfile
#   and writes the difference to docs/evidence/image-comparison.md.
#
#   It still uses the same .dockerignore, so no secrets reach it.
# ═══════════════════════════════════════════════════════════════
FROM node:26.9.0-bookworm@sha256:347d9d5391493c2fc3f0d161b75a9cab64a9805064b1b01b099f8ee97f98ed47

WORKDIR /app
COPY . .
RUN npm ci && npm run build

EXPOSE 3000
CMD ["npm", "start"]
