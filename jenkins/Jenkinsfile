// ═══════════════════════════════════════════════════════════════
//   splitx-deploy: deploys one signed release to this cluster, and rolls
//   it back if it does not come up healthy (D-055).
//
//   GitHub starts it. The release job in .github/workflows/ci.yml creates
//   a GitHub deployment (D-054), GitHub sends the "deployment" webhook, the
//   relay passes it on (D-056), and Jenkins accepts it only with GitHub's
//   signature. The job, its trigger and its parameters are defined in
//   helm/platform/jenkins.values.yaml, and so are the DEPLOY_* settings.
//
//   The procedure (this file and jenkins/deploy.mjs) comes from main. The
//   manifests come from the commit being deployed, so the pods get the
//   configuration their code was written for.
//
//     Request    well formed, for this cluster, and still the newest deployment
//     Verify     cosign: signed by this repository's CI on main, for that commit
//     Deploy     the commit's manifests, with the image replaced by the verified digest
//     Roll out   the database, the schema Job and the application
//     Check      every ready pod runs the digest; the edge serves only them
//     Archive    cosign verifies the release's SBOM and vulnerability report;
//                both are stored in Nexus with the deployment's record
//     failed?    roll the application back to the revision it had before
//     always     report the outcome on the GitHub deployment
// ═══════════════════════════════════════════════════════════════
pipeline {
    agent {
        kubernetes {
            // The chart's agent template: the pinned inbound agent over
            // WebSocket, the restricted security context, the deployer account.
            inheritFrom 'default'
            defaultContainer 'tools'
            yaml '''
apiVersion: v1
kind: Pod
metadata:
  labels:
    app.kubernetes.io/name: splitx-deployer
spec:
  serviceAccountName: jenkins-deployer
  securityContext:
    runAsNonRoot: true
    runAsUser: 1000
    runAsGroup: 1000
    seccompProfile:
      type: RuntimeDefault
  containers:
    - name: tools
      # Node, pinned as in the Dockerfile. kubectl and cosign are not
      # installed into it: their projects' own images are mounted read-only
      # (image volumes), so what runs is exactly what they published.
      image: node:24.21.0-alpine3.24@sha256:be80f76cf40ec8e42b9bec49f60a55e0660f30af58d3e5a25530785b30ea67e2
      command: ["sleep"]
      args: ["infinity"]
      env:
        - name: PATH
          value: /tools/kubectl/bin:/tools/cosign/ko-app:/usr/local/bin:/usr/bin:/bin
        - name: HOME
          value: /home/jenkins/agent
      resources:
        requests:
          cpu: 100m
          memory: 256Mi
        limits:
          memory: 512Mi
      securityContext:
        allowPrivilegeEscalation: false
        readOnlyRootFilesystem: true
        capabilities:
          drop: ["ALL"]
      volumeMounts:
        - name: kubectl
          mountPath: /tools/kubectl
          readOnly: true
        - name: cosign
          mountPath: /tools/cosign
          readOnly: true
        - name: tmp
          mountPath: /tmp
  volumes:
    - name: kubectl
      image:
        reference: registry.k8s.io/kubectl:v1.35.0@sha256:0bb95b2a450875fc8ceaea2f9987a99fe27c228846e2e00b93b65ebb0d59034e
        pullPolicy: IfNotPresent
    - name: cosign
      image:
        reference: ghcr.io/sigstore/cosign/cosign:v3.1.3@sha256:9e5c2f2edc34351160407ca3416c61855bdf9403c3c5936e0f0be7fc261611b8
        pullPolicy: IfNotPresent
    - name: tmp
      emptyDir: {}
'''
        }
    }

    options {
        timeout(time: 25, unit: 'MINUTES')
        // The procedure and the release are checked out below, each where it belongs.
        skipDefaultCheckout()
    }

    stages {
        stage('Request') {
            steps {
                // This file's own revision of main: the procedure.
                container('jnlp') {
                    dir('pipeline') { checkout scm }
                }
                withCredentials([string(credentialsId: 'github-deployments-token', variable: 'GITHUB_TOKEN')]) {
                    script {
                        def status = sh(script: 'node pipeline/jenkins/deploy.mjs request', returnStatus: true)
                        if (status == 3) {
                            env.SUPERSEDED = 'true'
                            currentBuild.description = 'superseded'
                        } else if (status != 0) {
                            error('the request was refused')
                        } else {
                            currentBuild.description = "${params.deployment_sha.substring(0, 12)} to ${params.deployment_environment}"
                        }
                    }
                }
            }
        }
        stage('Verify') {
            when { expression { env.SUPERSEDED != 'true' } }
            steps {
                sh 'node pipeline/jenkins/deploy.mjs verify'
            }
        }
        stage('Deploy') {
            when { expression { env.SUPERSEDED != 'true' } }
            steps {
                // The commit being deployed: its manifests.
                container('jnlp') {
                    dir('release') {
                        checkout scmGit(
                            branches: [[name: params.deployment_sha]],
                            userRemoteConfigs: [[url: 'https://github.com/Sayandip-Jana-1018/SplitX.git']]
                        )
                    }
                }
                sh 'node pipeline/jenkins/deploy.mjs deploy'
            }
        }
        stage('Roll out') {
            when { expression { env.SUPERSEDED != 'true' } }
            steps {
                sh 'node pipeline/jenkins/deploy.mjs wait'
            }
        }
        stage('Check') {
            when { expression { env.SUPERSEDED != 'true' } }
            steps {
                sh 'node pipeline/jenkins/deploy.mjs check'
            }
        }
        stage('Archive') {
            when { expression { env.SUPERSEDED != 'true' } }
            steps {
                // The release is deployed and checked by now. Evidence that can't
                // be verified or stored is reported on the GitHub deployment, and
                // the stage shows unstable, but a healthy release is not rolled
                // back for it (D-096).
                withCredentials([usernamePassword(credentialsId: 'nexus-evidence', usernameVariable: 'NEXUS_USER', passwordVariable: 'NEXUS_PASSWORD')]) {
                    catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                        sh 'node pipeline/jenkins/deploy.mjs archive'
                    }
                }
            }
        }
    }

    post {
        // Failed or aborted: put back what ran before. Runs before cleanup.
        unsuccessful {
            script {
                if (fileExists('pipeline/jenkins/deploy.mjs')) {
                    sh 'node pipeline/jenkins/deploy.mjs rollback'
                }
            }
        }
        // Last of all, with the final result: tell GitHub.
        cleanup {
            script {
                if (fileExists('pipeline/jenkins/deploy.mjs')) {
                    withCredentials([string(credentialsId: 'github-deployments-token', variable: 'GITHUB_TOKEN')]) {
                        withEnv(["BUILD_RESULT=${currentBuild.currentResult}"]) {
                            sh 'node pipeline/jenkins/deploy.mjs report'
                        }
                    }
                }
            }
        }
    }
}
