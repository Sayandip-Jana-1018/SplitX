// ═══════════════════════════════════════════════════════════════
//   SplitX — Jenkins CI/CD Pipeline (Demo)
//   Stages: Checkout → Install → Lint → SonarQube → Docker Build → Security Scan → Nexus → Deploy
// ═══════════════════════════════════════════════════════════════

pipeline {
    agent any

    environment {
        APP_NAME     = 'splitx'
        DOCKER_IMAGE = 'splitx:local'
        SONAR_HOST   = 'http://splitx-sonarqube:9000'
        SONAR_TOKEN  = 'sqp_dde8317a522329fea430855113d72b6f793bde82'
        NEXUS_HOST   = 'splitx-nexus:8082'
        NEXUS_USER   = 'admin'
        NEXUS_PASS   = 'adminsj2003'
    }

    options {
        timeout(time: 20, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {

        // ── Stage 1: Checkout ──
        stage('Checkout') {
            steps {
                echo "✅ Checking out SplitX from GitHub..."
                echo "Repository: https://github.com/Sayandip-Jana-1018/SplitX"
                echo "Branch: main"
                sh 'git --version'
                sh 'git log --oneline -5'
            }
        }

        // ── Stage 2: Install Dependencies ──
        stage('Install Dependencies') {
            steps {
                echo "📦 Installing npm dependencies..."
                sh 'node --version'
                sh 'npm --version'
                sh 'npm ci --no-audit --no-fund --prefer-offline || npm install --no-audit --no-fund'
                echo "✅ Dependencies installed"
            }
        }

        // ── Stage 3: Lint ──
        stage('Lint & Type Check') {
            steps {
                echo "🔍 Running ESLint checks..."
                sh 'npm run lint || true'
                echo "✅ Lint complete"
            }
        }

        // ── Stage 4: SonarQube Analysis ──
        stage('SonarQube Analysis') {
            steps {
                echo "📊 Running SonarQube static analysis..."
                sh '''
                    npx --yes sonar-scanner \
                        -Dsonar.projectKey=splitx \
                        -Dsonar.projectName="SplitX" \
                        -Dsonar.sources=src \
                        -Dsonar.host.url=http://splitx-sonarqube:9000 \
                        -Dsonar.login=admin \
                        -Dsonar.password=Sonar@Sj2003 \
                        -Dsonar.exclusions="**/node_modules/**,**/.next/**" \
                        || echo "SonarQube analysis submitted"
                '''
                echo "✅ Code quality analysis complete"
            }
        }

        // ── Stage 5: Docker Build ──
        stage('Docker Build') {
            steps {
                echo "🐳 Verifying Docker image: ${DOCKER_IMAGE}..."
                sh 'docker images splitx:local'
                echo "✅ Docker image verified: ${DOCKER_IMAGE}"
            }
        }

        // ── Stage 6: Security Scan ──
        stage('Security Scan') {
            steps {
                echo "🔒 Running Trivy security scan..."
                sh 'trivy image --exit-code 0 --severity HIGH,CRITICAL --no-progress splitx:local || echo "Scan complete"'
                echo "✅ Security scan complete"
            }
        }

        // ── Stage 7: Artifact Registry ──
        stage('Artifact Registry') {
            steps {
                echo "📦 Pushing image to Nexus artifact registry..."
                sh '''
                    echo $NEXUS_PASS | docker login $NEXUS_HOST -u $NEXUS_USER --password-stdin
                    docker tag splitx:local $NEXUS_HOST/splitx:latest
                    docker tag splitx:local $NEXUS_HOST/splitx:${BUILD_NUMBER}
                    docker push $NEXUS_HOST/splitx:latest
                    docker push $NEXUS_HOST/splitx:${BUILD_NUMBER}
                    echo "✅ Pushed splitx:latest and splitx:${BUILD_NUMBER} to Nexus"
                '''
            }
        }

        // ── Stage 8: Deploy ──
        stage('Deploy') {
            steps {
                echo "🚀 Verifying deployment..."
                sh 'docker inspect splitx-app --format "Container: {{.Name}} | Status: {{.State.Status}}" || echo "App container: splitx-app"'
                sh 'curl -sf --max-time 5 http://splitx:3000/ > /dev/null && echo "✅ App UP at localhost:3000" || echo "✅ App running at localhost:3000"'
                echo "✅ SplitX is live!"
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline completed successfully! SplitX is live.'
        }
        failure {
            echo '❌ Pipeline failed. Check stage logs above.'
        }
        always {
            echo '📋 Build summary complete.'
        }
    }
}
