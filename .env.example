# ═══════════════════════════════════════════════════════════════
# SplitX — Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ── Database (Neon PostgreSQL) ──
# Get this from: https://console.neon.tech → Your Project → Connection Details
# Pooled connection (for app runtime)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Direct connection (for prisma push/migrate — remove -pooler from hostname)
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── NextAuth ──
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ── Google OAuth (optional — for Google sign-in) ──
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── GitHub OAuth (optional — for GitHub sign-in) ──
# Get from: https://github.com/settings/developers → OAuth Apps
GITHUB_ID="your-github-oauth-app-id"
GITHUB_SECRET="your-github-oauth-app-secret"

# ── Gemini API (for AI chat) ──
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"

# ── Resend (for email — password reset, invitations) ──
# Get from: https://resend.com/api-keys
RESEND_API_KEY="your-resend-api-key"

# ── OpenAI API (for advanced OCR scan) ──
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY="your-openai-api-key"

# ── Supabase (for file storage — receipts, avatars) ──
# Get from: https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key used for storage uploads. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-anon-key"

# ── Rate limiting ──
# Backend: REDIS_URL (TCP — Kubernetes, Docker) takes precedence over Upstash
# (REST — Vercel). With neither set, rate limiting is disabled and a warning is
# logged; splitx_rate_limiter_info{backend="disabled"} exposes it.
REDIS_URL=
# Get from: https://console.upstash.com → Your Database → REST API
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"
# Proxies in front of the app that append to X-Forwarded-For. The client IP is
# read this many entries from the RIGHT (never the client-written left side):
# Vercel / ingress-nginx / single ALB = 1, CloudFront → ALB = 2, nothing = 0.
TRUSTED_PROXY_HOPS=1
# Limits per minute. api: per signed-in user (IP when anonymous); auth: login,
# registration and password-reset email, per IP; preview: settlement preview.
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_PREVIEW_PER_MINUTE=60
# How long to wait on the backend before letting the request through.
RATE_LIMIT_TIMEOUT_MS=300

# ── Settlement preview (POST /api/settlements/preview) ──
# A preview that has already waited this long on a saturated pod is refused with
# 503 and Retry-After instead of being planned late.
PREVIEW_MAX_QUEUE_MS=1000

# ── Observability ──
# Bearer token Prometheus uses to scrape /api/metrics. In production the endpoint
# refuses to serve metrics when this is unset. Generate: openssl rand -base64 32
METRICS_TOKEN=

# ── Local docker compose stack ──
# Password for the compose Postgres container. Must match the password its data
# volume was created with. Host tools reach it on localhost:5433.
POSTGRES_PASSWORD=
# Password for the compose Redis used for rate limiting (requirepass).
REDIS_PASSWORD=
# Grafana admin password — applied when Grafana creates its admin user on first boot.
GF_ADMIN_PASSWORD=
