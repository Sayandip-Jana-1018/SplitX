# ═══════════════════════════════════════════════════════════════
# SplitX — Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ── Database (Neon PostgreSQL) ──
# Get this from: https://console.neon.tech → Your Project → Connection Details
# Pooled connection (for app runtime)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Direct connection (for prisma push/migrate — remove -pooler from hostname)
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── NextAuth ──
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ── Google OAuth (optional — for Google sign-in) ──
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── GitHub OAuth (optional — for GitHub sign-in) ──
# Get from: https://github.com/settings/developers → OAuth Apps
GITHUB_ID="your-github-oauth-app-id"
GITHUB_SECRET="your-github-oauth-app-secret"

# ── Gemini API (for AI chat) ──
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"

# ── Email: password resets and address confirmation (lib/email.ts) ──
# Either SMTP (a Gmail account with an app password reaches any address, no
# domain needed: https://myaccount.google.com/apppasswords) ...
# Commented out so a copied template doesn't switch email on with placeholders.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"   # STARTTLS, required; 465 also works where the network allows it
# SMTP_USER="your-sender@gmail.com"
# SMTP_PASSWORD="your-16-letter-app-password"
# ... or Resend with EMAIL_FROM on a domain verified in Resend. Resend's shared
# onboarding@resend.dev only reaches the Resend account's owner, so it is not used.
# Get from: https://resend.com/api-keys
RESEND_API_KEY="your-resend-api-key"
# EMAIL_FROM="SplitX <mail@your-domain.com>"
# With neither, nothing is emailed and new accounts don't need confirming.

# ── OpenAI API (for advanced OCR scan) ──
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY="your-openai-api-key"

# ── AI spending limits (optional; defaults shown) ──
# Every AI call counts against the person's daily allowance and one ceiling for
# all of SplitX, in the rate limiter's Redis (lib/aiQuota.ts). Past a limit the
# chat and voice fall back to answers built without AI; receipt scans point to
# on-device scanning. AI_DISABLED=true switches every AI feature off at once.
# GEMINI_MODEL="gemini-3.6-flash"
# AI_DISABLED="false"
# AI_DAILY_CHAT_PER_USER="30"
# AI_DAILY_VOICE_PER_USER="40"
# AI_DAILY_RECEIPT_PER_USER="10"
# AI_DAILY_GLOBAL="400"

# ── Supabase (file storage only — receipts and avatars; the database is Neon) ──
# Get from: https://supabase.com → Project Settings → API Keys
# Read on the server only (receipt URL checks and storage calls), so it is not
# compiled into browser code and one Docker image works in every environment.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# Server-only secret key (sb_secret_…, or the legacy service_role key). Signs
# receipt upload URLs and uploads profile photos; without it both are refused
# (503). Never prefix with NEXT_PUBLIC_. The browser needs no Supabase key.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-secret-key"

# ── Rate limiting ──
# Backend: REDIS_URL (TCP — Kubernetes, Docker) takes precedence over Upstash
# (REST — Vercel). With neither set, rate limiting is disabled and a warning is
# logged; splitx_rate_limiter_info{backend="disabled"} exposes it.
REDIS_URL=
# Get from: https://console.upstash.com → Your Database → REST API
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"
# Proxies in front of the app that append to X-Forwarded-For. The client IP is
# read this many entries from the RIGHT (never the client-written left side):
# Vercel / ingress-nginx / single ALB = 1, CloudFront → ALB = 2, nothing = 0.
TRUSTED_PROXY_HOPS=1
# Limits per minute. api: per signed-in user (IP when anonymous); auth: login,
# registration and password-reset email, per IP; preview: settlement preview.
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_PREVIEW_PER_MINUTE=60
# How long to wait on the backend before letting the request through.
RATE_LIMIT_TIMEOUT_MS=300

# ── Settlement preview (POST /api/settlements/preview) ──
# A preview that has already waited this long on a saturated pod is refused with
# 503 and Retry-After instead of being planned late.
PREVIEW_MAX_QUEUE_MS=1000

# ── Observability ──
# Bearer token Prometheus uses to scrape /api/metrics. In production the endpoint
# refuses to serve metrics when this is unset. Generate: openssl rand -base64 32
METRICS_TOKEN=

# ── Local docker compose stack ──
# Password for the compose Postgres container. Must match the password its data
# volume was created with. Host tools reach it on localhost:5433.
POSTGRES_PASSWORD=
# Password for the compose Redis used for rate limiting (requirepass).
REDIS_PASSWORD=

# ── Monitoring on the Kubernetes cluster (npm run k8s:up) ──
# Grafana admin password, for http://grafana.localhost (user: admin).
GF_ADMIN_PASSWORD=
# Alert emails, sent by Alertmanager through Gmail. The password is a Google App
# Password (https://myaccount.google.com/apppasswords, needs 2-Step Verification),
# not the account password. Leave all three empty and alerts still fire and show
# in Grafana, but are not emailed.
ALERT_SMTP_USERNAME=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_TO=

# ── Delivery: Jenkins and the webhook relay (npm run k8s:up) ──
# The first `npm run k8s:up` generates the three random values below and the
# smee.io channel into your own .env, and prints only their names. Leave them
# empty here. Read them from .env when GitHub asks for them:
#   SMEE_URL              the webhook's Payload URL (repository Settings -> Webhooks)
#   GITHUB_WEBHOOK_SECRET the webhook's Secret; Jenkins refuses a delivery
#                         whose signature does not match it
#   JENKINS_ADMIN_PASSWORD  for http://jenkins.localhost (user: admin)
#   JENKINS_TRIGGER_TOKEN   the relay's token for Jenkins' webhook endpoint
JENKINS_ADMIN_PASSWORD=
GITHUB_WEBHOOK_SECRET=
JENKINS_TRIGGER_TOKEN=
SMEE_URL=
# Yours to create, and needed in practice: a fine-grained personal access token
# with "Deployments: read and write" on this repository only. Every deploy build
# first asks GitHub which deployment is the newest, and without a token that
# question comes out of GitHub's anonymous allowance: 60 an hour per public
# address, shared with every other device behind it (B-026). With it Jenkins
# also reports each deployment's outcome back to GitHub, under Environments.
JENKINS_GITHUB_TOKEN=
