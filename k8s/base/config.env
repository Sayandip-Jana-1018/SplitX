# ═══════════════════════════════════════════════════════════════
#   Non-secret settings for every SplitX pod, one KEY=value per line.
#
#   Kustomize turns this file into a ConfigMap whose name carries a hash
#   of its contents, and points the Deployment at that name. Changing a
#   value here therefore rolls the pods — which is the point: environment
#   variables are read once at start-up, so editing a plain ConfigMap in
#   place changes nothing until something else restarts them.
#
#   Secrets (DATABASE_URL, NEXTAUTH_SECRET, METRICS_TOKEN, REDIS_URL, ...)
#   come from the splitx-secrets Secret, created from .env at deploy time.
# ═══════════════════════════════════════════════════════════════
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
PORT=3000

# Next's standalone server binds to HOSTNAME. Without 0.0.0.0 it listens on
# localhost inside the container and every probe and Service request fails.
HOSTNAME=0.0.0.0

LOG_LEVEL=info

# Only used to build invite and password-reset links; NextAuth itself trusts the
# forwarded host. The AWS overlay replaces it with the public hostname.
NEXTAUTH_URL=http://localhost

# One proxy in front of the pod (ingress-nginx), so the client address is the
# last entry in X-Forwarded-For — the one ingress-nginx appended. CloudFront in
# front of an ALB would make it 2.
TRUSTED_PROXY_HOPS=1

# How long Node keeps an idle connection open, in ms. It must outlast the proxy
# in front, or the proxy reuses a connection at the moment Node closes it and
# the request fails with a 502 (connection reset while reading headers).
# ingress-nginx keeps upstream connections for 60 s, and so does an ALB; Next's
# standalone server defaults to 5 s.
KEEP_ALIVE_TIMEOUT=65000

# Shed a settlement preview that has already waited a second in the queue.
PREVIEW_MAX_QUEUE_MS=1000

# Where /ops reads the cluster from: ops-api, beside the app in every cluster
# (k8s/ops, D-097). Vercel has no cluster and leaves it unset, and /ops says
# "not connected" there.
OPS_API_URL=http://ops-api.ops.svc.cluster.local:8080
