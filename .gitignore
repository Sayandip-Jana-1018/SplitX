# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — every variant is local; only the documented template is committed
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# terraform: providers, modules, state and plans never enter the repository
# (state lives in the splitx-bootstrap stack's S3 bucket).
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
.terraform.tfstate.lock.info
# .terraform.lock.hcl IS committed: it pins provider versions and checksums.

# python
__pycache__/
*.py[cod]
*$py.class


# user uploads live in Supabase Storage, never in the repo or the image
/public/uploads/

# the OCR engine, copied from node_modules before each build (scripts/tesseract-assets.mjs)
/public/tesseract/

# generated scan and test reports
/reports/

# cluster-up --target eks: its temporary kustomization for the release to run
.cluster-up-eks-*/
# cluster-up, either target: the same for the ops image (D-097)
.cluster-up-ops-*/
# kind-e2e.yml: what a run measures on its runner, uploaded as an artifact (D-099)
e2e-evidence/

# Playwright (tests/e2e, D-107): the report, and each failure's screenshots and trace
playwright-report/
test-results/
blob-report/
